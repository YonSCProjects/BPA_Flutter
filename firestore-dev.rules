rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // DEVELOPMENT RULES - Allow public read for testing
    // WARNING: DO NOT USE IN PRODUCTION
    
    // Allow public read access to educators and students
    match /educators/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    match /students/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    match /config/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}