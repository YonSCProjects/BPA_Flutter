rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // IMPORTANT: These rules maintain compatibility with both Flutter app and Web Admin
    
    // Allow authenticated users (OAuth) AND service accounts to read/write
    // The Flutter app uses direct Firebase access without authentication
    // but the service account has implicit permissions
    
    match /users/{document=**} {
      // Allow read for authenticated users OR allow all reads for Flutter app compatibility
      allow read: if request.auth != null || true;
      // Only authenticated users can write (admin portal)
      allow write: if request.auth != null;
    }
    
    match /educators/{document=**} {
      // Allow read for all (Flutter app needs this)
      allow read: if true;
      // Only authenticated users can write (admin portal)
      allow write: if request.auth != null;
    }
    
    match /students/{document=**} {
      // Allow read for all (Flutter app needs this)
      allow read: if true;
      // Only authenticated users can write (admin portal)
      allow write: if request.auth != null;
    }
    
    // Config collection for app settings
    match /config/{document=**} {
      // Allow read for all (Flutter app needs this)
      allow read: if true;
      // Only authenticated users can write
      allow write: if request.auth != null;
    }
  }
}